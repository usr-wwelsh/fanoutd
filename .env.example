# Copy to .env for development, or install at
# $XDG_CONFIG_HOME/fanoutd/env for a deployed server.

OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
PORT=8080

# Gates the API when set. Leave empty for local-only use; set it before
# exposing the server to anything but localhost. The same value is what the
# browser login prompt asks for.
FANOUT_TOKEN=

# Where the database and agent workspaces live. Defaults to
# $XDG_DATA_HOME/fanoutd, i.e. ~/.local/share/fanoutd.
# Set it to "." to keep state in the repo while developing, or to an absolute
# path on a deployed server.
# FANOUT_DATA_DIR=/var/lib/fanoutd

# Relative values are resolved inside FANOUT_DATA_DIR, never the working
# directory. Absolute values are used as given.
# DATABASE_PATH=fanoutd.db
# OUTPUT_DIR=output

# How many subtasks of one broken-down idea run at once. The limit that bites
# first is the provider's, not the machine's — raise it only if your key can
# take the concurrency. Defaults to 3.
# FANOUT_MAX_PARALLEL=3

# Copy to .env for development, or install at
# $XDG_CONFIG_HOME/fanoutd/env for a deployed server.
#
# Everything here is also editable from the board, under the gear button. Saving
# there rewrites this file in place — comments and ordering survive — and applies
# the change to the running server. PORT and the three paths below are the
# exceptions: they are saved and wait for a restart.

# Which endpoint to talk to. Every provider below speaks the same OpenAI
# chat/completions protocol, so switching is one line rather than a plugin:
#
#   openrouter (default)  openai  anthropic  gemini  groq  deepseek
#   mistral  xai  together  fireworks  cerebras
#   ollama  llamacpp  vllm  lmstudio        (local, no key needed)
#   custom                                  (needs FANOUT_BASE_URL)
#
# FANOUT_PROVIDER=openrouter

FANOUT_API_KEY=sk-or-v1-your-key-here
FANOUT_MODEL=inclusionai/ling-3.0-flash:free

# Override the provider's published endpoint — a local server on a port the
# defaults do not guess, or a proxy in front of a vendor. Required for "custom".
# FANOUT_BASE_URL=http://localhost:11434/v1

# The original names still work and mean the same thing. Set either.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=

PORT=8080

# Gates the API when set. Leave empty for local-only use; set it before
# exposing the server to anything but localhost. The same value is what the
# browser login prompt asks for.
FANOUT_TOKEN=

# Where the database and agent workspaces live. Defaults to
# $XDG_DATA_HOME/fanoutd, i.e. ~/.local/share/fanoutd.
# Set it to "." to keep state in the repo while developing, or to an absolute
# path on a deployed server.
# FANOUT_DATA_DIR=/var/lib/fanoutd

# Relative values are resolved inside FANOUT_DATA_DIR, never the working
# directory. Absolute values are used as given.
# DATABASE_PATH=fanoutd.db
# OUTPUT_DIR=output

# How many subtasks of one broken-down idea run at once. The limit that bites
# first is the provider's, not the machine's — raise it only if your key can
# take the concurrency. Defaults to 3.
# FANOUT_MAX_PARALLEL=3

# Steps one agent run gets before it concedes. A budget, not a safety rail: the
# agent already stops itself on repetition and on unusable output, so this only
# bites a run that is still making progress. Too low and a task three steps from
# a clean build concedes with code that does not compile, and whatever waits on
# it builds against that. Lower it only to cap spend on a paid key — a model
# that converges quickly never reaches the limit anyway. Defaults to 40.
# FANOUT_MAX_STEPS=40

# Sends every finished run to a second agent before it lands in Finished. The
# reviewer reads and runs the work but cannot change it, and either passes it or
# sends it back as a rework task, at most twice before it waits for you. Off by
# default: it spends a second model call per task and can start runs of its own.
# Worth far more with FANOUT_SHELL on, since then the reviewer can execute what
# it is judging rather than only read it.
# FANOUT_REVIEW=1

# The model the reviewer runs on. Empty means the same one the task used, which
# is the weak setting — a model reviewing its own output agrees with it. Pick a
# different one, and one that supports tool calls.
# FANOUT_REVIEW_MODEL=

# Lets agents run shell commands so they can build and test what they write.
# Requires working bubblewrap: if the sandbox will not start, the tool is never
# offered and agents stay file-only. Off by default.
# FANOUT_SHELL=1

# Network inside the sandbox. Off means no dependency downloads — and no way to
# exfiltrate a workspace or an API key. Turn it on only if you need it.
# FANOUT_SHELL_NET=0

# Per-command wall clock, in seconds. Defaults to 120.
# FANOUT_SHELL_TIMEOUT=120

# Resource limits, applied as a transient systemd user scope. Skipped with a
# warning where there is no user manager to place a scope in.
# FANOUT_SHELL_MEMORY=2G
# FANOUT_SHELL_CPU=200%
# FANOUT_SHELL_TASKS=512

# Cap on concurrent commands across all tasks. Unlimited by default: the cgroup
# limits above already bound the machine, and serializing here would make the
# rolling-parallel scheduler run one wide at its most expensive step. Set it
# only if you actually see thrash.
# FANOUT_MAX_EXEC=0

# Extra host paths mounted read-only, for toolchains installed outside /usr —
# rustup, nvm, pyenv, `go install`. Colon-separated. Any entry with a bin/
# subdirectory joins PATH inside the sandbox. Empty by default: binding a whole
# home directory would hand every agent your ssh keys.
# FANOUT_SHELL_ROBIND=/home/you/.cargo:/home/you/.rustup

# Shared toolchain caches and per-task build directories. Resolved inside
# FANOUT_DATA_DIR like the others.
# FANOUT_SANDBOX_DIR=sandbox
